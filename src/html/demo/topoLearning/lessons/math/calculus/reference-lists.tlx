\page{
  title = Συγκεντρωτικές Λίστες και Τυπολόγιο
  description = Η ενότητα λειτουργεί ως γρήγορο σημείο αναφοράς για βασικούς τύπους, συμβολισμούς και μεθοδολογικές λίστες της Μαθηματικής Ανάλυσης.
}

\section{Πώς χρησιμοποιείται το τυπολόγιο}

\paragraph{
Οι συγκεντρωτικές λίστες βοηθούν τον φοιτητή να ανακαλεί γρήγορα τύπους, κανόνες και μεθόδους. Στη μηχανική αυτό είναι χρήσιμο όταν πρέπει να επιλεγεί σωστό μαθηματικό εργαλείο για ένα πρόβλημα μετρήσεων, μοντελοποίησης, προσομοίωσης ή βελτιστοποίησης.
}

\warning{
Το τυπολόγιο δεν αντικαθιστά τη θεωρία. Πριν εφαρμοστεί ένας τύπος πρέπει να ελέγχονται οι προϋποθέσεις του.
}

\table{
  title = Βασικός συμβολισμός
  caption = Συγκεντρωτική λίστα συμβολισμών που εμφανίζονται συχνά.
  style = academic
  align = left
  width = full

  columns = Σύμβολο | Σημασία | Σχόλιο

  rows =
  \( f(x) \) | Τιμή συνάρτησης | Η \(x\) είναι ανεξάρτητη μεταβλητή.;
  \( D_f \) | Πεδίο ορισμού | Επιτρεπτές τιμές της \(x\).;
  \( f'(x) \) | Πρώτη παράγωγος | Στιγμιαίος ρυθμός μεταβολής.;
  \( f''(x) \) | Δεύτερη παράγωγος | Κυρτότητα ή επιτάχυνση.;
  \( \int f(x)\,dx \) | Αόριστο ολοκλήρωμα | Οικογένεια αντιπαραγώγων.;
  \( \int_a^b f(x)\,dx \) | Ορισμένο ολοκλήρωμα | Συσσωρευμένη μεταβολή.;
  \( \nabla f \) | Διάνυσμα κλίσης | Διεύθυνση μέγιστης αύξησης.
}

\table{
  title = Κανόνες παραγώγισης
  caption = Βασικά εργαλεία υπολογισμού παραγώγων.
  style = academic
  align = left
  width = full

  columns = Περίπτωση | Τύπος | Παρατήρηση

  rows =
  Σταθερά | \( \frac{d}{dx}c=0 \) | Η σταθερά δεν μεταβάλλεται.;
  Δύναμη | \( \frac{d}{dx}x^n=n x^{n-1} \) | Κανόνας δύναμης.;
  Άθροισμα | \( (f+g)'=f'+g' \) | Γραμμικότητα.;
  Γινόμενο | \( (fg)'=f'g+fg' \) | Δεν είναι \(f'g'\).;
  Πηλίκο | \( \left(\frac{f}{g}\right)'=\frac{f'g-fg'}{g^2} \) | Όπου \(g\neq 0\).;
  Σύνθεση | \( (f(g(x)))'=f'(g(x))g'(x) \) | Κανόνας αλυσίδας.
}

\table{
  title = Βασικές παράγωγοι και ολοκληρώματα
  caption = Οι παρακάτω σχέσεις είναι συχνές σε υπολογισμούς.
  style = academic
  align = left
  width = full

  columns = Συνάρτηση | Παράγωγος | Βασικό ολοκλήρωμα

  rows =
  \( x^n \) | \( n x^{n-1} \) | \( \int x^n\,dx=\frac{x^{n+1}}{n+1}+C,\quad n\neq -1 \).;
  \( e^x \) | \( e^x \) | \( \int e^x\,dx=e^x+C \).;
  \( \ln x \) | \( \frac{1}{x} \) | \( \int \frac{1}{x}\,dx=\ln\lvert x\rvert+C \).;
  \( \sin x \) | \( \cos x \) | \( \int \sin x\,dx=-\cos x+C \).;
  \( \cos x \) | \( -\sin x \) | \( \int \cos x\,dx=\sin x+C \).;
  \( \tan x \) | \( \sec^2 x \) | \( \int \sec^2 x\,dx=\tan x+C \).
}

\table{
  title = Πρακτικός οδηγός επιλογής μεθόδου
  caption = Σύντομη μεθοδολογία για βασικές περιπτώσεις.
  style = academic
  align = left
  width = full

  columns = Πρόβλημα | Πρώτος έλεγχος | Πιθανό εργαλείο

  rows =
  Θέλω ρυθμό μεταβολής | Είναι η συνάρτηση παραγωγίσιμη; | Παράγωγος.;
  Θέλω συνολική μεταβολή | Γνωρίζω ρυθμό ή πυκνότητα; | Ορισμένο ολοκλήρωμα.;
  Θέλω εμβαδόν | Μπορώ να περιγράψω τα όρια; | Ολοκλήρωμα.;
  Θέλω ακρότατο | Υπάρχουν κρίσιμα σημεία; | Παράγωγοι.;
  Θέλω προσεγγιστική τιμή | Δεν υπάρχει απλή αναλυτική λύση; | Αριθμητική μέθοδος.
}

\plotplayground{
  title = Playground βασικών συναρτήσεων
  functions = x^2
sin(x)
exp(x)
  xMin = -5
  xMax = 5
  yMin = -5
  yMax = 5
}

\exercise{Άσκηση 1}{
Να χρησιμοποιήσεις το τυπολόγιο για να βρεις την παράγωγο της \( f(x)=x^3+\sin x \).
}

\solution{Λύση Άσκησης 1}{
Με τον κανόνα αθροίσματος:

\[
f'(x)=3x^2+\cos x
\]
}


