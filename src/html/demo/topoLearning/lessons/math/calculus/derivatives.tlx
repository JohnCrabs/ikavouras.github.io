\page{
  title = Η Έννοια της Παραγώγου
  description = Αναλυτική ενότητα για Η Έννοια της Παραγώγου, με ορισμούς, θεωρήματα, αποδείξεις, παραδείγματα, κώδικα και ασκήσεις.
}

\section{Μαθηματικό υπόβαθρο και χρήση στη μηχανική}

\paragraph{
Η παράγωγος είναι στιγμιαίος ρυθμός μεταβολής. Στη μηχανική δίνει ταχύτητα, επιτάχυνση, κλίση εδάφους, ρυθμό παραμόρφωσης ή ευαισθησία μοντέλου.
}

\definition{Παράγωγος}{
\(f'(a)=\lim_{h\to0}\frac{f(a+h)-f(a)}{h}\), εφόσον το όριο υπάρχει.
}

\definition{Εφαπτομένη}{
Η ευθεία \(y-f(a)=f'(a)(x-a)\) είναι η εφαπτομένη στο \((a,f(a))\).
}

\table{
  title = Βασικές σχέσεις και έννοιες
  caption = Ο πίνακας λειτουργεί ως σύντομος οδηγός αναφοράς για την ενότητα.
  style = academic
  align = left
  width = full

  columns = Στοιχείο | Μαθηματική μορφή | Σχόλιο

  rows =
  Μέση μεταβολή | \(\frac{f(b)-f(a)}{b-a}\) | Κλίση τέμνουσας.;
  Στιγμιαία μεταβολή | \(f'(a)\) | Κλίση εφαπτομένης.;
  Θέση σε ταχύτητα | \(v=s'\) | Παράγωγος θέσης.;
  Ταχύτητα σε επιτάχυνση | \(a=v'\) | Παράγωγος ταχύτητας.
}

\definition{Κεντρικό θεώρημα ή βασική πρόταση}{
Αν η \(f\) είναι παραγωγίσιμη στο \(a\), τότε είναι συνεχής στο \(a\).
}

\solution{Απόδειξη ή αιτιολόγηση}{
Γράφουμε \(f(x)-f(a)=\frac{f(x)-f(a)}{x-a}(x-a)\). Καθώς \(x\to a\), ο πρώτος παράγοντας τείνει στο \(f'(a)\) και ο δεύτερος στο \(0\). Άρα \(f(x)-f(a)\to0\).
}

\example{Παράδειγμα εφαρμογής}{
Για \(s(t)=t^2+2t\), η ταχύτητα είναι \(v(t)=2t+2\). Στο \(t=3\), \(v(3)=8\).
}

\code{Python}{
import math

def derivative_central(f, x):
    return f(x)
}

\code{C++}{
#include <functional>
#include <cmath>

double derivative_central(std::function<double(double)> f, double x) {
    return (f(x+h)-f(x-h))/(2*h);
}
}

\code{JavaScript}{
function derivative_central(f, x) {
  return (f(x + h) - f(x - h)) / (2*h);
}
}

